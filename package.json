{
  "name": "autocrop-pro",
  "private": true,
  "version": "0.1.4",
  "type": "module",
  "scripts": {
    "start": "tauri dev",
    "dev": "vite",
    "website": "vite --config website/vite.config.ts",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "test": "vitest run",
    "test:watch": "vitest",
    "website:build": "tsc -p website && vite build --config website/vite.config.ts && vite build --config website/vite.config.ts --ssr src/entry-server.tsx --outDir dist-ssr && node website/scripts/prerender.mjs",
    "website:preview": "vite preview --config website/vite.config.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@mantine/core": "^9.7.0",
    "@mantine/dropzone": "^9.7.0",
    "@mantine/hooks": "^9.7.0",
    "@mantine/notifications": "^9.7.0",
    "@phosphor-icons/react": "^2.1.10",
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20.11.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.0.2",
    "jsdom": "^28.1.0",
    "postcss": "^8.4.33",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "typescript": "^5.2.2",
    "vite": "^8.0.13",
    "vitest": "^4.1.6"
  }
}
